server {
    listen 80 default_server;
    root /var/www/html;
    index index.html index.htm index.nginx-debian.html;
    server_name _;

    location /2026/ {
        root /var/www/html;
        try_files $uri $uri/ /2026/index.html;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
